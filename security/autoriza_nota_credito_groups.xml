<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="privilege_autorizaciones" model="res.groups.privilege">
        <field name="name">Autorizaciones</field>
        <field name="sequence">46</field>
    </record>

    <record id="group_autoriza_nota_credito" model="res.groups">
        <field name="name">Autoriza notas de crédito</field>
        <field name="privilege_id" ref="privilege_autorizaciones"/>
        <field name="comment">Puede confirmar notas de crédito de venta en las compañías donde el control está activo. Sin este permiso, la nota de crédito se carga igual pero queda en borrador.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

</odoo>
